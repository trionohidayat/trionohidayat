# ==========================================
# Triono Hidayat Portfolio - Environment Variables
# ==========================================

# Vercel API Access Token
# Buat token di: https://vercel.com/account/tokens
# Beri nama "portfolio-integration", pilih Scope: Read Only atau Full Account
VERCEL_TOKEN=

# (Opsional) Vercel Team ID
# Isi hanya jika proyek Vercel Anda berada di dalam Vercel Team (bukan personal account)
# Dapat dilihat di Team Settings di Vercel Dashboard
# VERCEL_TEAM_ID=

# (Opsional) Daftar nama proyek yang ingin disembunyikan dari web portofolio (dipisahkan koma)
# VERCEL_IGNORED_PROJECTS=my-secret-test,draft-app
